# TriBench Framework Environment Configuration
# ================================================
# This file contains all environment variables used by the TriBench framework.
# Copy this file to `.env` and fill in the actual values for your environment.
#
# SECURITY NOTE: Never commit the `.env` file to version control!
# The `.env` file is listed in `.gitignore` to prevent accidental commits.

# ==============================================================================
# PostgreSQL Configuration (Hive Metastore Backend)
# ==============================================================================

# PostgreSQL database credentials
# Used by Hive Metastore for storing Iceberg table metadata
POSTGRES_USER=hive
POSTGRES_PASSWORD=hive_password
POSTGRES_DB=metastore
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# PostgreSQL connection string (alternative to individual params)
# Format: postgresql://user:password@host:port/database
# POSTGRES_CONNECTION_STRING=postgresql://hive:hive_password@localhost:5432/metastore

# ==============================================================================
# MinIO Configuration (S3-Compatible Object Storage)
# ==============================================================================

# MinIO root credentials (admin access)
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=password

# MinIO access keys (for application access)
# These are used by Trino to access data in MinIO
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# MinIO endpoint configuration
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# MinIO bucket configuration
MINIO_BUCKET=warehouse
MINIO_REGION=us-east-1

# ==============================================================================
# Trino Configuration
# ==============================================================================

# Trino authentication (if using password authentication)
# By default, Trino uses no authentication in development mode
TRINO_USER=admin
TRINO_PASSWORD=

# Trino coordinator configuration
TRINO_HOST=localhost
TRINO_PORT=8080

# Trino catalog configuration
TRINO_CATALOG=iceberg
TRINO_SCHEMA=default

# ==============================================================================
# Hive Metastore Configuration
# ==============================================================================

# Hive Metastore connection configuration
HIVE_METASTORE_HOST=localhost
HIVE_METASTORE_PORT=9083

# Hive Metastore warehouse location (S3/MinIO path)
HIVE_METASTORE_WAREHOUSE=s3a://warehouse/

# ==============================================================================
# Framework Configuration
# ==============================================================================

# Logging configuration
LOG_LEVEL=INFO
LOG_DIR=log

# Result storage configuration
RESULTS_DIR=results
RESULTS_DB_ENABLED=false

# Results database connection (if RESULTS_DB_ENABLED=true)
RESULTS_DB_USER=tribench
RESULTS_DB_PASSWORD=
RESULTS_DB_HOST=localhost
RESULTS_DB_PORT=5432
RESULTS_DB_NAME=tribench_results

# ==============================================================================
# API Tokens and External Services (Future Use)
# ==============================================================================

# GitHub token for downloading releases (optional)
# GITHUB_TOKEN=

# Docker Hub credentials (optional, for private images)
# DOCKER_USERNAME=
# DOCKER_PASSWORD=

# Cloud provider credentials (for future cloud deployment support)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=

# AZURE_SUBSCRIPTION_ID=
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=

# ==============================================================================
# Development and Testing
# ==============================================================================

# Test database configuration (separate from production)
TEST_POSTGRES_USER=test_user
TEST_POSTGRES_PASSWORD=test_password
TEST_POSTGRES_DB=test_db

# Enable debug mode (verbose logging, additional checks)
DEBUG=false

# Dry run mode (simulate operations without executing)
DRY_RUN=false
