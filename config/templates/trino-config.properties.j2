# Trino Configuration Properties
# Generated by TriBench from HOCON configuration

# Coordinator or worker
coordinator={{ config.get("tribench.systems.trino.coordinator.enabled", True)|string|lower }}

# HTTP server configuration
http-server.http.port={{ config.get("tribench.systems.trino.coordinator.port", 8080) }}

# Discovery server
discovery.uri=http://{{ config.get("tribench.systems.trino.coordinator.host", "localhost") }}:{{ config.get("tribench.systems.trino.coordinator.port", 8080) }}

# Query configuration
query.max-memory={{ config.get("tribench.systems.trino.query.max_memory", "4GB") }}
query.max-memory-per-node={{ config.get("tribench.systems.trino.query.max_memory_per_node", "1GB") }}
