# Trino Configuration Properties
# Generated by TriBench from HOCON configuration

# Coordinator or worker
coordinator={{ config.tribench.systems.trino.coordinator.enabled|lower }}

# HTTP server configuration
http-server.http.port={{ config.tribench.systems.trino.coordinator.port }}

# Discovery server
discovery.uri=http://{{ config.tribench.systems.trino.coordinator.host }}:{{ config.tribench.systems.trino.coordinator.port }}

# Query configuration
query.max-memory={{ config.tribench.systems.trino.query.max_memory }}
query.max-memory-per-node={{ config.tribench.systems.trino.query.max_memory_per_node }}
query.max-total-memory-per-node={{ config.tribench.systems.trino.query.max_total_memory_per_node }}
