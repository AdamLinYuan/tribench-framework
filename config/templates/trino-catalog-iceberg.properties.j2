# Iceberg Catalog Configuration
# Connector type
connector.name=iceberg

# Catalog type - use Hive Metastore
iceberg.catalog.type=hive_metastore
hive.metastore.uri=thrift://{{ config.tribench.systems.hive_metastore.docker.service_name }}:{{ config.tribench.systems.hive_metastore.port }}

# S3-compatible storage (MinIO) - using Trino native S3
fs.native-s3.enabled=true
s3.endpoint=http://{{ config.tribench.systems.minio.docker.service_name }}:{{ config.tribench.systems.minio.port }}
s3.aws-access-key={{ config.tribench.systems.minio.access_key }}
s3.aws-secret-key={{ config.tribench.systems.minio.secret_key }}
s3.path-style-access=true
s3.region={{ config.tribench.systems.minio.region }}

# Iceberg format settings
iceberg.file-format=PARQUET
iceberg.compression-codec=SNAPPY

# Table location
iceberg.unique-table-location=true

# Performance tuning
iceberg.max-partitions-per-writer=1000
iceberg.target-max-file-size=1GB
